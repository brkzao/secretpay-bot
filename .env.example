# Porta/host do servidor HTTP interno do bot.
# Na Railway use HOST=:: — a rede privada é IPv6 e "0.0.0.0" só escuta IPv4,
# deixando o bot inalcançável pelo painel.
PORT=3333
HOST=0.0.0.0

# Onde o SQLite com as credenciais das sessões é gravado.
# Em produção (Railway) aponte para dentro de um volume persistente,
# ex.: /data/bot.db — sem volume, todas as sessões caem a cada deploy.
DATABASE_PATH=./data/bot.db

# URL base do painel Laravel (sem barra no final)
LARAVEL_URL=http://localhost:8000

# Segredo compartilhado com o Laravel (BOT_SHARED_SECRET no .env de lá).
# Assina o HMAC nas duas direções. Gere com: openssl rand -hex 32
BOT_SHARED_SECRET=troque-por-um-segredo-de-64-caracteres

LOG_LEVEL=info

# Reconexão em lote no boot (evita rate-limit do WhatsApp)
SESSION_BOOT_BATCH=5
SESSION_BOOT_DELAY_MS=2000

# Tempo de inatividade até a conversa ser descartada
CONVERSATION_TTL_MINUTES=15

# Faixa de valor aceita, espelhando OMOPIX_MIN_AMOUNT/OMOPIX_MAX_AMOUNT do
# painel. Quem manda de verdade é o adquirente do OmoPix: fora da faixa dele a
# criação da cobrança responde 422. Validar aqui só torna o erro instantâneo.
MIN_ORDER_AMOUNT=200
MAX_ORDER_AMOUNT=5000

# Libera as rotas /internal/simulate e o comando `npm run simulate`, que
# permitem conversar com o bot sem WhatsApp. Mantenha false em produção.
SIMULATION_ENABLED=false
